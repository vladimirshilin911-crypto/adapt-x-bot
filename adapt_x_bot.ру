import os
import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

logging.basicConfig(level=logging.INFO)
TOKEN = os.getenv("TELEGRAM_TOKEN")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🚀 Adapt-X Bot запущен!\n\n"
        "Новый чистый аккаунт GitHub - бан снят.\n"
        "Команды:\n/start - проверить\n/ping - жив ли бот"
    )

async def ping(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("✅ Бот на связи! Railway OK")

if __name__ == "__main__":
    if not TOKEN:
        raise ValueError("Нет TELEGRAM_TOKEN в переменных Railway!")
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("ping", ping))
    print("Bot started...")
    app.run_polling()
